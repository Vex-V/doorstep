# Copy to .env. The defaults run the demo: Doorstep against the Ring simulator.
#   python scripts/demo_clips.py                      (once: the demo footage)
#   python -m ringsim scenarios/demo/scenario.json    (terminal 1)
#   python -m doorstep                                (terminal 2)

# The vision model and the LLM. openai (gpt-6-luna by default) | stub (no
# network, canned answers: tries the plumbing only)
OPENAI_API_KEY=
DOORSTEP_MODELS=openai
DOORSTEP_VLM=
DOORSTEP_LLM=
# Search embeddings: local (bge-small, free, downloaded on first use) | openai
DOORSTEP_EMBEDDER=local

# The Ring simulator (python -m ringsim): the API base, its token, and follow
# its clock, so the scripted day's times are the app's.
RING_API_BASE=http://127.0.0.1:8100
RING_SIM=1
RING_TOKEN=sim-token
RINGSIM_TOKEN=sim-token
# Webhooks are signed with this; the simulator reads the same variable.
RING_WEBHOOK_SECRET=change-me
# The Chime to sound when an alert fires, and which of its two slots.
RING_CHIME_DEVICE=chime
RING_CHIME_EVENT=ring-appstore-event-1

# Ring's Developer Playground instead: set
#   RING_API_BASE=https://api.amazonvision.com   RING_SIM=0   RING_TOKEN=
#   RING_TOKEN_FILE=.ring_token    (paste the 30-minute token in; re-read on every call)
#   RING_POLL_SECONDS=15           (the Playground sends no webhooks: poll Event History)
#   RING_CHIME_DEVICE=             (the Playground has no Chime)
RING_TOKEN_FILE=
RING_POLL_SECONDS=0
# Also process events already in history when polling starts.
RING_BACKFILL=0

# The family's time zone: rule windows and the digest are in it.
DOORSTEP_TZ=Europe/London
# Where Doorstep keeps its database, clips, snapshots and the library's output.
DOORSTEP_DATA=data
# Read each clip's soundtrack too (Whisper; needs vidra's audio extras). Off.
DOORSTEP_AUDIO=0
# Days of footage kept before it is deleted.
DOORSTEP_RETENTION_DAYS=7
